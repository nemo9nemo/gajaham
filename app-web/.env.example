GAJAHAM_API_KEY=public-client-api-key
GAJAHAM_PROJECT_ID=example-project
GAJAHAM_AUTH_DOMAIN=example-project.firebaseapp.com
GAJAHAM_APP_ID=1:000000000000:web:example
GAJAHAM_APP_CHECK_KEY=public-recaptcha-enterprise-site-key
GAJAHAM_ORIGIN=https://example-project.web.app
# 문의 창구 준비 전에는 비워 둔다. 개발 화면은 준비 중으로 표시한다.
# 실제 주소를 만든 뒤 이메일 또는 HTTPS 문의 URL로 교체한다.
GAJAHAM_CONTACT=
